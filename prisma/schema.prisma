// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id            String     @id @default(cuid())
  name          String
  phone         String
  email         String?
  area          String? // where it hurts (Knee, Back / spine, ...)
  duration      String? // how long it has been (Under 3 months, ...)
  branch        String?    @default("T. Nagar")
  source        String? // utm_source or "direct"
  medium        String? // utm_medium
  campaign      String? // utm_campaign
  pageUrl       String? // full landing-page URL the lead came from
  // Present in the live database but absent from this schema until now, so any
  // `prisma db push` would have dropped them (one row holds data). Nothing
  // currently writes them — they predate the current /api/leads payload.
  location      String? // city / location, from the hair-scan chat flow
  photoData     String? // uploaded scalp photo, stored as a data URL
  status        LeadStatus @default(NEW)
  telecrmSynced Boolean    @default(false)
  telecrmId     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  SCHEDULED
  CONVERTED
  LOST
}

/// Client feedback from /client-feedback — the private arm of the /review
/// funnel. 4–5 stars go to Google; 1–3 land here instead.
model Feedback {
  id            String   @id @default(cuid())
  name          String
  phone         String
  email         String
  rating        Int      @default(0) // 1–5 from /review, 0 when they skipped it
  suggestions   String
  source        String? // e.g. "thereshape — Client Feedback"
  pageUrl       String? // full URL the feedback was submitted from
  telecrmSynced Boolean  @default(false)
  telecrmId     String?
  sheetSynced   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("feedback")
}
